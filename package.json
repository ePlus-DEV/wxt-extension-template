{
  "name": "wxt-extension-template",
  "description": "Production-ready WXT browser extension template by ePlus.DEV",
  "private": true,
  "version": "0.1.0",
  "author": "dev@eplus.dev",
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@4.14.1",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "prepare": "wxt prepare",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "build:opera": "wxt build -b opera",
    "build:all": "yarn build && yarn build:firefox && yarn build:edge && yarn build:opera",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "zip:opera": "wxt zip -b opera",
    "zip:all": "yarn zip && yarn zip:firefox && yarn zip:edge && yarn zip:opera",
    "check": "yarn compile && yarn lint && yarn test && yarn build:all",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@wxt-dev/storage": "^1.1.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.0",
    "@wxt-dev/auto-icons": "^1.1.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^30.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.50.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.9",
    "wxt": "^0.21.2"
  }
}
